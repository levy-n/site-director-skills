---
// BaseLayout.example.astro: the wiring for a multi-page Astro site with ClientRouter page
// transitions (move T-07) on pattern-breaker's motion engine. Copy to src/layouts/BaseLayout.astro
// and adapt; the files it imports are listed in assets/motion/README.md (Astro section).
//
// What this layout guarantees:
// - <ClientRouter /> in <head>; NO transition:* directive on <html> (it would rename the root
//   snapshot and the page mask CSS would stop matching).
// - The header is named and not animated, so it stays still above the wipe.
// - The cursor layer (only when a dossier item justifies a cursor) is persisted across navigation:
//   the same canvas node moves into every new page. Its CSS (a fixed full-screen layer above the
//   page and above the wipe) comes from page-transition.css; add none of your own.
// - One module script boots the motion lifecycle; section scripts only register with defineMotion.
// - The content is complete without JavaScript: no element is hidden in the HTML.
//
// Prefetch: ClientRouter turns on prefetchAll unless astro.config sets prefetch: false. On a
// media-heavy site set it to false and prefetch the few links that matter.
import { ClientRouter } from 'astro:transitions';
import '../styles/reduced-motion.css';
import '../styles/page-transition.css';
import 'lenis/dist/lenis.css';

interface Props {
  title: string;
  description?: string;
  /** Render the persisted cursor layer. Only with a dossier item and a decision row (budget). */
  cursor?: boolean;
}
const { title, description, cursor = false } = Astro.props;
---

<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">דילוג לתוכן</a>

    {cursor && (
      <div class="mw-cursor-layer" aria-hidden="true" transition:persist="mw-cursor-layer">
        <canvas></canvas>
      </div>
    )}

    <header class="site-header" transition:name="site-header" transition:animate="none">
      <slot name="header" />
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <slot name="footer" />
    </footer>

    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import { SplitText } from 'gsap/SplitText';
      import Lenis from 'lenis';
      import { bootMotion } from '../motion/motion-boot.js';

      // Once per full load. The page lifetime (engine, Lenis, sections, cursor) is rebuilt on every
      // astro:page-load and torn down on astro:before-swap by motion-boot.js.
      const motion = bootMotion({ gsap, ScrollTrigger, SplitText, Lenis });

      // The stop switch (WCAG 2.2.2), if the page has one: a real button in the footer or the
      // accessibility menu. Never persisted between visits.
      document.addEventListener('click', (e) => {
        const button = (e.target as Element | null)?.closest('[data-stop-motion]');
        if (button) motion.stopAnimations();
      });
    </script>
  </body>
</html>
